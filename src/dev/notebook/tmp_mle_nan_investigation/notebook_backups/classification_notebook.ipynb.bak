    "# ── Classification hyperparameters ───────────────────────────────────────────\n",
    "GAMMA       = 0.1    # Soft-DTW smoothing\n",
    "N_STEPS     = 750    # barycenter optimisation steps\n",
    "LR          = 0.0051   # adam learning rate\n",
    "STA_EPSILON = 0.05   # Sinkhorn regularisation for sta\n",
    "KNN_K       = 1      # k for KNN\n",
    "# ─────────────────────────────────────────────────────────────────────────────"
   ]
