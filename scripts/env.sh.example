#!/bin/bash
# Copy this file to scripts/env.sh and fill in the paths.
# scripts/env.sh is gitignored (contains machine-specific paths).

# Root of the repository (directory containing this scripts/ folder)
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Virtual-environment location
VENV_DIR="$PROJECT_ROOT/venv"

# Activate the virtual environment
source "$VENV_DIR/bin/activate"

# Make all project layers importable via PYTHONPATH
export PYTHONPATH="$PROJECT_ROOT:$PROJECT_ROOT/lib:${PYTHONPATH:-}"

# Data paths — override these for your machine
export DATA_NC_PATH="/path/to/data_version-5.nc"
export DATA_CSV_PATH="$PROJECT_ROOT/data/stations_regimes_explore2.csv"
export DATASET_DIR="$PROJECT_ROOT/results/classification_dataset"
export RESULTS_DIR="$PROJECT_ROOT/results"
